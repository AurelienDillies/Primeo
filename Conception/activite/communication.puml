@startuml Communication entre les utilisateurs

title Communication entre les utilisateurs

|Utilisateur 1|
start
:Se connecter à son compte;
|Système|
:Authentifier l'utilisateur;
|Utilisateur 1|
:Accéder à la section "Messages";
|Système|
:Afficher la boîte de réception;
|Utilisateur 1|
:Sélectionner un message;
|Système|
:Afficher le contenu du message;
|Utilisateur 1|
repeat 
:Répondre au message;
|Système|
:Envoyer la réponse;
|Utilisateur 2|
:Recevoir la réponse;
if (Le message de l'utilisateur 1 nécessite une réponse?) then (Oui)
  |Utilisateur 2|
  :Répondre au message;
  |Système|
  :Envoyer la réponse;
  |Utilisateur 1|
  :Recevoir la réponse;
  :Lire le message;
else (Non)
  |Utilisateur 2|
  :Lire le message;
  stop
endif 
|Utilisateur 1|
repeat while(Le message de l'utilisateur 2 nécessite une réponse?) is (Oui)
stop

@enduml