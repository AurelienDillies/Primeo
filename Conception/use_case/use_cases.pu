@startuml
title Use Case Diagram - Plateforme Digiforma

left to right direction
skinparam dpi 220
skinparam backgroundColor White
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 60
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam actorFontSize 20
skinparam usecaseFontSize 17
skinparam usecase {
	BorderColor #2F3B52
	BackgroundColor #F8FAFC
	FontSize 17
}
skinparam actor {
	BorderColor #2F3B52
	FontColor #1F2937
	FontSize 20
}

actor "Enseignant" as Teacher
actor "Eleve" as Student
actor "Parent" as Parent
actor "Administrateur" as Admin

rectangle "Plateforme Digiforma" {
	package "Acces et profil" {
		usecase "S'inscrire" as UC1
		usecase "Se connecter" as UC2
		usecase "Gerer son profil" as UC3
	}

	package "Fonctions pedagogiques" {
		usecase "Consulter le tableau de bord" as UC4
		usecase "Gerer les classes" as UC5
		usecase "Publier des cours" as UC6
		usecase "Creer des activites" as UC7
		usecase "Consulter les contenus" as UC8
		usecase "Echanger et recevoir des notifications" as UC9
		usecase "Suivre les progres des eleves" as UC10
	}

	package "Administration" {
		usecase "Gerer les utilisateurs" as UC11
		usecase "Superviser les classes et les cours" as UC12
		usecase "Consulter statistiques et rapports" as UC13
		usecase "Traiter les demandes de support" as UC14
	}
}

Teacher --> UC2
Teacher --> UC3
Teacher --> UC4
Teacher --> UC5
Teacher --> UC6
Teacher --> UC7
Teacher --> UC9
Teacher --> UC10

Student --> UC2
Student --> UC3
Student --> UC4
Student --> UC8
Student --> UC9

Parent --> UC2
Parent --> UC3
Parent --> UC4
Parent --> UC9

Admin --> UC2
Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14

@enduml
