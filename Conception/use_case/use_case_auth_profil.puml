@startuml
title Authentification et profil
left to right direction
actor "Enseignant" as Enseignant
actor "Eleve" as Eleve
actor "Parent" as Parent
actor "Administrateur" as Administrateur

rectangle "Plateforme" {
  usecase "Creer un compte" as UC01
  usecase "Valider email" as UC01A
  usecase "Confirmer email" as UC01B
  usecase "Se connecter" as UC02
  usecase "Verifier identifiants" as UC02A
  usecase "Reinitialiser mot de passe" as UC02B
  usecase "Gerer son profil" as UC03
  usecase "Charger profil" as UC03A
  usecase "Mettre a jour profil" as UC03B
}

UC01 ..> UC01A : <<include>>
UC01B ..> UC01 : <<extend>>
UC02 ..> UC02A : <<include>>
UC02B ..> UC02 : <<extend>>
UC03 ..> UC03A : <<include>>
UC03B ..> UC03 : <<extend>>

Enseignant --> UC01
Eleve --> UC01
Parent --> UC01

Enseignant --> UC02
Eleve --> UC02
Parent --> UC02
Administrateur --> UC02

Enseignant --> UC03
Eleve --> UC03
Parent --> UC03
@enduml
