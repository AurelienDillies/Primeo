@startuml
title Activites et evaluation
left to right direction
actor "Enseignant" as Enseignant
actor "Eleve" as Eleve

rectangle "Plateforme" {
  usecase "Ajouter une activite" as UC08
  usecase "Mettre a jour ou supprimer une activite" as UC09
  usecase "Acceder aux ressources de classe" as UC10
  usecase "Soumettre une activite" as UC11
  usecase "Verifier droits" as UCX01
  usecase "Valider activite" as UCX02
  usecase "Verifier delai" as UCX03
  usecase "Enregistrer soumission" as UCX04
  usecase "Charger ressources" as UCX05
  usecase "Supprimer activite" as UC09A
  usecase "Joindre fichiers" as UC11A
}

UC08 ..> UCX01 : <<include>>
UC08 ..> UCX02 : <<include>>
UC09 ..> UCX01 : <<include>>
UC09 ..> UCX02 : <<include>>
UC09A ..> UC09 : <<extend>>
UC10 ..> UCX01 : <<include>>
UC10 ..> UCX05 : <<include>>
UC11 ..> UCX01 : <<include>>
UC11 ..> UCX03 : <<include>>
UC11 ..> UCX04 : <<include>>
UC11A ..> UC11 : <<extend>>

Enseignant --> UC08
Enseignant --> UC09
Eleve --> UC10
Eleve --> UC11
@enduml
